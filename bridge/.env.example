# Bridge L2 Impure — copia pra .env e preenche os valores reais

# ----- MySQL L2J (local na VPS) -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=l2jbridge
DB_PASSWORD=trocar_senha_aqui
DB_NAME=l2jdb

# ----- Auth (mesmos valores no Railway: BRIDGE_API_KEY / BRIDGE_HMAC_SECRET) -----
API_KEY=gera_com_openssl_rand_hex_32
HMAC_SECRET=gera_com_openssl_rand_hex_64

# ----- Server -----
PORT=8080
HOST=127.0.0.1                 # 127.0.0.1 = só Cloudflare Tunnel; 0.0.0.0 = público (NÃO usar)
LOG_LEVEL=info                 # trace|debug|info|warn|error|fatal
NODE_ENV=production

# ----- Tolerância de timestamp (anti-replay) -----
HMAC_MAX_SKEW_MS=30000         # 30s — janela em que requests são aceitos

# ----- L2J game/login server (pra /status) -----
L2J_LOGIN_HOST=127.0.0.1
L2J_LOGIN_PORT=2106
L2J_GAME_HOST=127.0.0.1
L2J_GAME_PORT=7777

# ----- Vote sites (config lida do site, tabela vote_sites) -----
# Bridge consulta GET {SITE_BASE_URL}/api/vote-sites/{slug} antes de
# aceitar callbacks. Editável no painel: /admin/marketing/vote-sites.
SITE_BASE_URL=https://www.l2impure.com
VOTE_CONFIG_TTL_MS=300000            # cache 5min
VOTE_CONFIG_FETCH_TIMEOUT_MS=5000
