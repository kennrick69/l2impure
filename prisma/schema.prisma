// L2 Impure — PostgreSQL schema (Fase 1)
// Ver: L2-IMPURE-ARQUITETURA-DEFINITIVA.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuário do site (conta web, não é a conta de jogo)
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  isVerified    Boolean   @default(false) @map("is_verified")
  role          UserRole  @default(user)
  coins         Int       @default(0)
  referralCode  String    @unique @map("referral_code") @db.VarChar(16)
  bannedAt      DateTime? @map("banned_at")
  bannedReason  String?   @map("banned_reason") @db.VarChar(255)
  gmPinHash     String?   @map("gm_pin_hash") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  gameAccounts        GameAccount[]
  auditLogs           AuditLog[]
  referralsGiven      Referral[]    @relation("UserReferrals")
  referralReceived    Referral?     @relation("UserReferralBy")
  announcements       Announcement[]
  walletTransactions  WalletTransaction[]

  @@map("users")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

/// Configurações de runtime editáveis pelo admin (offset de player count,
/// flag do sistema de referrals, valores de recompensa, etc).
/// Valor é JSON pra ser flexível.
model Setting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

/// Anúncios do servidor — aparecem na seção "Últimas Notícias" da landing.
model Announcement {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(120)
  content      String
  publishedAt  DateTime  @default(now()) @map("published_at")
  archivedAt   DateTime? @map("archived_at")
  createdById  Int?      @map("created_by_id")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([archivedAt])
  @@map("announcements")
}

/// Indicação: ligação 1-pra-1 entre quem indicou (referrer) e quem foi indicado (referred).
/// Conversão acontece quando o referred atinge level 40 em qualquer personagem.
model Referral {
  id          Int             @id @default(autoincrement())
  referrerId  Int             @map("referrer_id")
  referredId  Int             @unique @map("referred_id")
  status      ReferralStatus  @default(pending)
  convertedAt DateTime?       @map("converted_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  referrer User @relation("UserReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("UserReferralBy", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

enum ReferralStatus {
  pending
  converted

  @@map("referral_status")
}

/// Refresh tokens (UUID opaco, armazenado pra permitir revoke)
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// Tokens de verificação de email e reset de senha (one-shot, uso único)
model VerificationToken {
  id        Int                   @id @default(autoincrement())
  userId    Int                   @map("user_id")
  token     String                @unique @db.VarChar(255)
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at")
  used      Boolean               @default(false)
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  verification
  reset

  @@map("verification_token_type")
}

/// Contas de jogo do L2J vinculadas ao usuário do site
model GameAccount {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  gameLogin String   @unique @map("game_login") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("game_accounts")
}

/// Códigos promocionais — admin cria, usuário resgata uma vez por código
model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(64)
  reward    Json
  maxUses   Int?      @map("max_uses")
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  redemptions PromoRedemption[]

  @@index([code])
  @@map("promo_codes")
}

model PromoRedemption {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  promoCodeId Int      @map("promo_code_id")
  redeemedAt  DateTime @default(now()) @map("redeemed_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
  @@index([userId])
  @@map("promo_redemptions")
}

/// Transações da carteira de coins — recarga via Mercado Pago, créditos
/// admin, bônus de referral, resgates de promo. amount em BRL (Decimal),
/// coins é a quantidade creditada (positiva) ou debitada (negativa).
model WalletTransaction {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  amount         Decimal   @db.Decimal(10, 2)
  coins          Int
  status         String    @default("pending") @db.VarChar(20)
  mpPaymentId    String?   @unique @map("mp_payment_id") @db.VarChar(64)
  mpPreferenceId String?   @map("mp_preference_id") @db.VarChar(64)
  type           String    @db.VarChar(20)
  description    String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

/// Audit log — registra ações sensíveis (login, criar conta de jogo, reset HWID, etc)
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(50)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_log")
}

/// Sites de voto (rankings) — HopZone, L2Top.CO, MMOTop, etc.
/// Editável pelo admin em /admin/marketing/vote-sites, consumido pela
/// bridge via GET /api/vote-sites/[slug] (cache 5min). JOs liga/desliga
/// cada ranking e cadastra o server ID sem mexer em código nem restart.
model VoteSite {
  id                Int      @id @default(autoincrement())
  slug              String   @unique @db.VarChar(32)
  displayName       String   @map("display_name") @db.VarChar(64)
  serverId          String?  @map("server_id") @db.VarChar(64)
  callbackUrl       String   @map("callback_url") @db.VarChar(255)
  callbackMethod    String   @default("GET") @map("callback_method") @db.VarChar(8)
  active            Boolean  @default(false)
  cooldownHours     Int      @default(12) @map("cooldown_hours")
  rewardCoins       Int      @default(1) @map("reward_coins")
  rewardDescription String?  @map("reward_description") @db.VarChar(255)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([active])
  @@map("vote_sites")
}

/// Config de evento do gameserver editável pelo painel admin.
/// `config` guarda os valores dos campos (unidades do próprio
/// .properties); `fileMapping` traduz campo → key do properties.
/// A UI/validação por campo vive em src/lib/event-config-catalog.ts.
/// Horários são interpretados em BRT (JVM roda com
/// -Duser.timezone=America/Sao_Paulo — Fase Admin 3A).
model EventConfig {
  id            Int       @id @default(autoincrement())
  slug          String    @unique @db.VarChar(48)
  displayName   String    @map("display_name") @db.VarChar(64)
  enabled       Boolean   @default(false)
  config        Json
  fileTarget    String    @map("file_target") @db.VarChar(96)
  fileMapping   Json      @map("file_mapping")
  lastAppliedAt DateTime? @map("last_applied_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("event_configs")
}

/// Secrets operacionais editáveis pelo painel admin (/admin/settings/secrets).
/// `value` NUNCA é plaintext: AES-256-GCM, base64(iv|ciphertext|tag), chave
/// derivada de JWT_SECRET via scrypt (ver src/lib/secrets.ts). Leitura em
/// runtime via getSecret(key, envFallback) — DB tem prioridade, env var é
/// fallback. NÃO ROTACIONAR JWT_SECRET sem re-encriptar tudo (SECRETS_ROTACAO.md).
model AdminSecret {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(64)
  value       String   @db.Text
  category    String   @default("general") @db.VarChar(32)
  description String?  @db.VarChar(255)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.VarChar(128)

  @@map("admin_secrets")
}
